<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/exp_canvas"
                android:startColor="#0C1524"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="120"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="#2E3DE8C8"
                android:type="linear" />
        </shape>
    </item>
    <item android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="300"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="#338B7CFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
