<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/exp_nav_bg" />
        </shape>
    </item>
    <item android:top="-2dp" android:bottom="0dp" android:left="-2dp" android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/exp_line" />
        </shape>
    </item>
</layer-list>
