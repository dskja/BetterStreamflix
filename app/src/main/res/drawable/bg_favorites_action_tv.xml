<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/bs_amber_muted" />
            <stroke android:width="2dp" android:color="@color/bs_amber" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/bs_amber" />
            <stroke android:width="2dp" android:color="@color/bs_mist" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/bs_ink_panel" />
            <stroke android:width="1dp" android:color="@color/bs_hairline" />
        </shape>
    </item>

</selector>
