<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#30FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#121216" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#16161E"
                android:centerColor="#101015"
                android:endColor="#0C0C10"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#0FFFFFFF" />
        </shape>
    </item>
</ripple>
