<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33E8A838">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/bs_ink_panel" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#161D27"
                android:centerColor="#10151C"
                android:endColor="#0B1016"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/bs_hairline" />
        </shape>
    </item>
</ripple>
