<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/support_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#120A0A"
                android:endColor="@color/support_bg"
                android:startColor="#1A0C0C"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:gravity="top|fill_horizontal"
        android:height="220dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="@color/support_accent_soft"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
