<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/support_dialog_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_support_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/support_hub_title"
                android:src="@mipmap/ic_launcher" />

            <ImageButton
                android:id="@+id/btn_support_startup_close"
                android:layout_width="@dimen/support_close_size"
                android:layout_height="@dimen/support_close_size"
                android:layout_gravity="end|center_vertical"
                android:alpha="0.55"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/support_startup_close_cd"
                android:padding="8dp"
                android:src="@drawable/ic_support_close"
                android:tint="@color/support_text_secondary"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_support_startup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/manrope"
            android:text="@string/support_startup_title"
            android:textColor="@color/support_text_primary"
            android:textSize="@dimen/support_text_screen_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_support_startup_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/manrope"
            android:lineSpacingExtra="3dp"
            android:text="@string/support_startup_body"
            android:textColor="@color/support_text_secondary"
            android:textSize="@dimen/support_text_body" />

        <TextView
            android:id="@+id/btn_support_startup_primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/support_button_height_lg"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_support_btn_primary"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/support_startup_cta_primary"
            android:textColor="@color/support_on_accent"
            android:textSize="@dimen/support_text_cta"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_support_startup_sponsors"
                android:layout_width="0dp"
                android:layout_height="@dimen/support_button_height"
                android:layout_weight="1"
                android:background="@drawable/bg_support_btn_secondary"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/support_startup_cta_sponsors"
                android:textColor="@color/support_text_primary"
                android:textSize="@dimen/support_text_caption" />

            <TextView
                android:id="@+id/btn_support_startup_bmc"
                android:layout_width="0dp"
                android:layout_height="@dimen/support_button_height"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_support_btn_secondary"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/support_startup_cta_bmc"
                android:textColor="@color/support_text_primary"
                android:textSize="@dimen/support_text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_support_startup_community"
            android:layout_width="match_parent"
            android:layout_height="@dimen/support_button_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_support_btn_secondary"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/support_startup_cta_community"
            android:textColor="@color/support_text_secondary"
            android:textSize="@dimen/support_text_caption" />

        <CheckBox
            android:id="@+id/cb_support_startup_never"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/support_accent"
            android:fontFamily="@font/manrope"
            android:text="@string/support_startup_never_again"
            android:textColor="@color/support_text_tertiary"
            android:textSize="@dimen/support_text_caption" />
    </LinearLayout>
</FrameLayout>
