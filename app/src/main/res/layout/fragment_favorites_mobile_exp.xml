<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exp_canvas_atmosphere">

    <TextView
        android:id="@+id/tv_favorites_eyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="0.12"
        android:text="@string/exp_catalog_eyebrow"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.Lumina.Eyebrow"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_favorites_reorder_mode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_favorites_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="-0.03"
        android:text="@string/main_menu_favorites"
        android:textAppearance="@style/TextAppearance.Lumina.Hero"
        android:textColor="?attr/colorOnSurface"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_favorites_reorder_mode"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_eyebrow"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_eyebrow"
        tools:text="Beispieltext" />

    <TextView
        android:id="@+id/tv_favorites_tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope"
        android:text="@string/exp_favorites_tagline"
        android:textAppearance="@style/TextAppearance.Lumina.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/tv_favorites_brand"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_brand" />

    <ImageButton
        android:id="@+id/btn_favorites_reorder_mode"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_exp_icon_chip"
        android:contentDescription="@string/favorites_rearrange_on"
        android:padding="11dp"
        android:src="@drawable/ic_reorder_white"
        app:layout_constraintEnd_toStartOf="@id/btn_favorites_reorder"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/btn_favorites_reorder"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_exp_icon_chip"
        android:contentDescription="@string/favorites_reorder_categories"
        android:padding="11dp"
        android:src="@drawable/ic_sort"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurface" />

    <View
        android:id="@+id/v_favorites_rule"
        android:layout_width="40dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_exp_accent_rule"
        app:layout_constraintStart_toStartOf="@id/tv_favorites_brand"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_tagline" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/favorites_actions_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="v_favorites_rule,btn_favorites_reorder_mode,btn_favorites_reorder" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/favorites_actions_bottom" />

    <TextView
        android:id="@+id/tv_favorites_empty"
        android:fontFamily="@font/manrope"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_favorite_disable"
        android:drawablePadding="18dp"
        android:drawableTint="?attr/colorOnSurfaceVariant"
        android:gravity="center"
        android:text="@string/favorites_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
