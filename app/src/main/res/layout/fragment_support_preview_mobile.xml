<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/support_bg"
    android:fitsSystemWindows="true"
    android:padding="@dimen/support_page_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <ImageButton
            android:id="@+id/btn_support_preview_back"
            android:layout_width="@dimen/support_close_size"
            android:layout_height="@dimen/support_close_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/support_back_cd"
            android:padding="8dp"
            android:src="@drawable/ic_support_back"
            android:tint="@color/support_text_primary"
            tools:ignore="UseAppTint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/manrope"
            android:text="@string/support_preview_title"
            android:textColor="@color/support_text_primary"
            android:textSize="@dimen/support_text_screen_title"
            android:textStyle="bold" />

        <include
            android:id="@+id/preview_hero"
            layout="@layout/include_support_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <include
            android:id="@+id/preview_banner"
            layout="@layout/item_support_banner_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/ll_preview_providers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
