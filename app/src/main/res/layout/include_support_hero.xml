<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/support_hero_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_support_hero_cinematic"
    android:minHeight="@dimen/support_hero_min_height"
    android:orientation="vertical"
    android:padding="@dimen/support_page_padding">

    <ImageView
        android:id="@+id/iv_support_hero_logo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/support_hub_title"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/tv_support_hero_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/manrope"
        android:letterSpacing="-0.01"
        android:text="@string/support_hero_title"
        android:textColor="@color/support_text_primary"
        android:textSize="@dimen/support_text_hero"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_support_hero_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/manrope"
        android:lineSpacingExtra="2dp"
        android:text="@string/support_hero_body"
        android:textColor="@color/support_text_secondary"
        android:textSize="@dimen/support_text_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_support_hero_primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/support_button_height"
            android:background="@drawable/bg_support_btn_primary"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="148dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/support_hero_cta_primary"
            android:textColor="@color/support_on_accent"
            android:textSize="@dimen/support_text_cta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_support_hero_secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/support_button_height"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_support_btn_secondary"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="120dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/support_hero_cta_secondary"
            android:textColor="@color/support_text_primary"
            android:textSize="@dimen/support_text_cta" />
    </LinearLayout>
</LinearLayout>
