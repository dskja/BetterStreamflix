<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/iv_episode_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_exp_poster_frame"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="@id/guideline1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_episode_download_ribbon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="6dp"
        android:elevation="2dp"
        android:src="@drawable/ic_offline_badge"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_episode_watched_ribbon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="6dp"
        android:elevation="2dp"
        android:src="@drawable/ic_watched"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.42" />

    <ProgressBar
        android:id="@+id/pb_episode_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="6dp"
        android:backgroundTint="#33FFFFFF"
        android:progressTint="@color/exp_accent"
        app:layout_constraintBottom_toBottomOf="@id/iv_episode_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintStart_toStartOf="@id/iv_episode_poster"
        tools:progress="80" />

    <TextView
        android:id="@+id/tv_episode_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/outfit"
        android:textColor="@color/exp_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Episode #" />

    <TextView
        android:id="@+id/tv_episode_released"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="@font/outfit"
        android:maxLines="1"
        android:textColor="@color/exp_mist"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/tv_episode_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_episode_info"
        app:layout_constraintTop_toTopOf="parent"
        tools:text=" • Release date" />

    <TextView
        android:id="@+id/tv_episode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/syne"
        android:maxLines="2"
        android:textColor="@color/exp_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_info"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_episode_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:maxLines="3"
        android:textColor="@color/exp_ink_soft"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline1"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_title"
        tools:text="Overview" />

</androidx.constraintlayout.widget.ConstraintLayout>
