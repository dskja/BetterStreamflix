<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_movie_poster"
        android:foreground="@drawable/bg_exp_poster_scrim"
        android:layout_width="0dp"
        android:layout_height="252dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumina.Poster"
        app:strokeColor="@color/exp_glass_strong"
        app:strokeWidth="1dp" />

    <ImageView
        android:id="@+id/iv_movie_favorite_ribbon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="9dp"
        android:elevation="2dp"
        android:src="@drawable/ic_favorite_badge"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_movie_poster"
        app:layout_constraintTop_toTopOf="@id/iv_movie_poster"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_movie_download_ribbon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="9dp"
        android:elevation="2dp"
        android:src="@drawable/ic_offline_badge"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_movie_poster"
        app:layout_constraintTop_toTopOf="@id/iv_movie_poster"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_movie_watched_ribbon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="3dp"
        android:elevation="2dp"
        android:src="@drawable/ic_watched"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_movie_poster"
        app:layout_constraintTop_toBottomOf="@id/iv_movie_favorite_ribbon"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_movie_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/bg_exp_meta_pill"
        android:fontFamily="@font/manrope"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:textAllCaps="true"
        android:textColor="@color/exp_on_accent"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/iv_movie_poster"
        app:layout_constraintTop_toBottomOf="@id/iv_movie_download_ribbon"
        app:layout_goneMarginTop="9dp"
        tools:text="HD"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_movie_released_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="9dp"
        android:fontFamily="@font/manrope"
        android:padding="2dp"
        android:textColor="@color/exp_on_media_muted"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_movie_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_movie_quality"
        tools:text="2022" />

    <ProgressBar
        android:id="@+id/pb_movie_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:progressDrawable="@drawable/bg_exp_progress_track"
        app:layout_constraintBottom_toBottomOf="@id/iv_movie_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_movie_poster"
        app:layout_constraintStart_toStartOf="@id/iv_movie_poster"
        tools:progress="80" />

    <TextView
        android:id="@+id/tv_movie_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/manrope"
        android:gravity="start"
        android:lines="2"
        android:textColor="@color/exp_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/iv_movie_poster"
        app:layout_constraintStart_toStartOf="@id/iv_movie_poster"
        app:layout_constraintTop_toBottomOf="@id/iv_movie_poster"
        tools:text="Title" />

</androidx.constraintlayout.widget.ConstraintLayout>
