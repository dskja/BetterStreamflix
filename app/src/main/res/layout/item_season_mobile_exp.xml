<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_season_poster"
        android:foreground="@drawable/bg_exp_poster_scrim"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@color/exp_surface"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumina.PosterSmall"
        app:strokeColor="@color/exp_glass_strong"
        app:strokeWidth="1dp"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_season_watched_ribbon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_margin="7dp"
        android:elevation="2dp"
        android:src="@drawable/ic_watched"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_season_poster"
        app:layout_constraintTop_toTopOf="@id/iv_season_poster"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_season_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:textColor="@color/exp_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_season_poster"
        tools:text="Season #" />

</androidx.constraintlayout.widget.ConstraintLayout>
