<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_support_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_support_impact_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope"
        android:textColor="@color/support_text_primary"
        android:textSize="@dimen/support_text_body"
        android:textStyle="bold"
        tools:text="Trakt VIP" />

    <TextView
        android:id="@+id/tv_support_impact_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/manrope"
        android:textColor="@color/support_text_secondary"
        android:textSize="@dimen/support_text_secondary"
        tools:text="Helps cover Trakt app credentials so login can stay free for everyone." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/pb_support_impact"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/support_accent" />

        <TextView
            android:id="@+id/tv_support_impact_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/manrope"
            android:textColor="@color/support_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="62%" />
    </LinearLayout>
</LinearLayout>
