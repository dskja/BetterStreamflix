<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:visibility="visible"
    tools:visibility="gone">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sh_is_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="?attr/colorSurfaceContainerHigh"
        app:shimmer_highlight_color="?attr/colorSurfaceBright">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="140dp">

            <View
                android:layout_width="140dp"
                android:layout_height="18dp"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_exp_skeleton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:background="@drawable/bg_exp_skeleton" />
            </LinearLayout>

            <View
                android:layout_width="140dp"
                android:layout_height="18dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="34dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_exp_skeleton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_exp_skeleton" />

                <View
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    android:background="@drawable/bg_exp_skeleton" />
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <ProgressBar
        android:id="@+id/pb_is_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:indeterminateTintMode="src_atop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_is_loading_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_exp_error"
        android:drawablePadding="16dp"
        android:gravity="center"
        android:text="@string/loading_error_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        app:layout_constraintBottom_toTopOf="@id/btn_is_loading_retry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/btn_is_loading_retry"
        style="@style/AppTheme.Widget.Mobile.Button.Exp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/loading_error_retry"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_is_loading_error" />

    <TextView
        android:id="@+id/btn_is_loading_clear_cache"
        style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/loading_error_clear_cache"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_is_loading_retry" />

    <TextView
        android:id="@+id/btn_is_loading_error_details"
        style="@style/AppTheme.Widget.Mobile.Button.Exp.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/loading_error_details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_is_loading_clear_cache" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_is_loading_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tv_is_loading_error,btn_is_loading_retry,btn_is_loading_clear_cache,btn_is_loading_error_details"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
