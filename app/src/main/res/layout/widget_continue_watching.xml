<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bs_ink_panel">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_continue_watching"
        android:textColor="@color/bs_mist"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_grotesk_bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/bs_mist_dim"
        android:textSize="13sp"
        android:fontFamily="@font/manrope_regular"
        android:text="@string/widget_continue_watching_empty" />
</LinearLayout>
