<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FF181818">

    <TextView
        android:id="@+id/widget_favorites_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_menu_favorites"
        android:textColor="#FFE8A838"
        android:textSize="12sp"
        android:textAllCaps="true" />

    <TextView
        android:id="@+id/widget_favorites_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/main_menu_favorites"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_favorites_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFB0B0B0"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_favorites_empty" />
</LinearLayout>
