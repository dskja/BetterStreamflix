<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bs_ink_panel">

    <TextView
        android:id="@+id/widget_favorites_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/main_menu_favorites"
        android:textColor="@color/bs_amber"
        android:textSize="12sp"
        android:fontFamily="@font/manrope_semibold"
        android:textAllCaps="false" />

    <TextView
        android:id="@+id/widget_favorites_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/main_menu_favorites"
        android:textColor="@color/bs_mist"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/space_grotesk_bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_favorites_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/bs_mist_dim"
        android:textSize="13sp"
        android:fontFamily="@font/manrope_regular"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_favorites_empty" />
</LinearLayout>
