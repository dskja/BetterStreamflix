    <color name="exp_cinema_bg">@color/exp_canvas</color>
    <color name="exp_cinema_surface">@color/exp_surface</color>
    <color name="exp_cinema_elevated">@color/exp_surface_elevated</color>
    <color name="exp_teal_accent">@color/exp_accent</color>
