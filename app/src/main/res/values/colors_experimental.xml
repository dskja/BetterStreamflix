    <color name="exp_steel_teal">@color/exp_accent</color>
    <color name="exp_steel_teal_dim">@color/exp_accent_deep</color>
    <color name="exp_text_muted">@color/exp_mist</color>
    <color name="exp_frost">@color/exp_ink</color>
    <color name="exp_signal">@color/exp_accent</color>
    <color name="exp_signal_dim">@color/exp_accent_deep</color>
    <color name="exp_haze">@color/exp_line</color>
    <color name="exp_ink_elevated">@color/exp_surface_elevated</color>
    <color name="exp_ink_nav">@color/exp_nav_bg</color>
</resources>
