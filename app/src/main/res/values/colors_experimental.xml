    <color name="m3_on_secondary">#253140</color>
    <color name="m3_secondary_container">#3B4858</color>
    <color name="m3_on_secondary_container">#D7E3F7</color>
    <color name="m3_tertiary">#D5BEE4</color>
    <color name="m3_on_tertiary">#3B2948</color>
    <color name="m3_tertiary_container">#523F61</color>
    <color name="m3_on_tertiary_container">#F1DAFF</color>
    <color name="m3_error">#FFB4AB</color>
    <color name="m3_on_error">#690005</color>
    <color name="m3_error_container">#93000A</color>
    <color name="m3_on_error_container">#FFDAD6</color>
    <color name="m3_surface">#101318</color>
