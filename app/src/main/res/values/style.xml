<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Widget.Tv.Button" parent="AppTheme.Tv">
        <item name="android:background">@drawable/bg_button_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@drawable/color_button_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button" parent="AppTheme.Mobile">
        <item name="android:background">@drawable/bg_button_mobile</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/bs_ink</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Secondary" parent="AppTheme.Widget.Mobile.Button">
        <item name="android:background">@drawable/bg_button_secondary_mobile</item>
        <item name="android:textColor">@color/bs_mist</item>
    </style>

    <style name="Bs.Text.Display" parent="TextAppearance.AppCompat.Large">
        <item name="android:fontFamily">@font/space_grotesk_bold</item>
        <item name="android:textColor">@color/bs_mist</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="Bs.Text.Title" parent="TextAppearance.AppCompat.Medium">
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textColor">@color/bs_mist</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Bs.Text.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="android:fontFamily">@font/manrope_regular</item>
        <item name="android:textColor">@color/bs_mist_dim</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PreferenceThemeOverlay.Leanback.Amoled" parent="PreferenceThemeOverlayLeanback">
        <item name="android:windowBackground">?attr/app_background_color</item>
        <item name="android:colorBackground">?attr/app_background_color</item>
    </style>

</resources>
