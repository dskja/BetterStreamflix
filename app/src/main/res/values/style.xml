<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Widget.Tv.Button" parent="AppTheme.Tv">
        <item name="android:background">@drawable/bg_button_tv</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@drawable/color_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button" parent="AppTheme.Mobile">
        <item name="android:background">@drawable/bg_button_mobile</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Secondary" parent="AppTheme.Widget.Mobile.Button">
        <item name="android:background">@drawable/bg_button_secondary_mobile</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp" parent="AppTheme.Mobile">
        <item name="android:background">@drawable/bg_exp_button_primary</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/exp_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp.Secondary" parent="AppTheme.Widget.Mobile.Button.Exp">
        <item name="android:background">@drawable/bg_exp_button_secondary</item>
        <item name="android:textColor">@color/exp_ink</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp.OnMedia" parent="AppTheme.Widget.Mobile.Button.Exp">
        <item name="android:background">@drawable/bg_exp_button_primary</item>
        <item name="android:textColor">@color/exp_on_accent</item>
    </style>

    <style name="AppTheme.Widget.Mobile.Button.Exp.OnMedia.Secondary" parent="AppTheme.Widget.Mobile.Button.Exp.Secondary">
        <item name="android:background">@drawable/bg_exp_button_on_media_secondary</item>
        <item name="android:textColor">@color/exp_on_media</item>
    </style>

    <!-- Stile per forzare il fondo nero nelle schermate di impostazione (Leanback) -->
    <!-- Usiamo direttamente android:background nella preferenceTheme per non romper il build -->
    <style name="PreferenceThemeOverlay.Leanback.Amoled" parent="PreferenceThemeOverlayLeanback">
        <item name="android:windowBackground">?attr/app_background_color</item>
        <item name="android:colorBackground">?attr/app_background_color</item>
    </style>

</resources>
