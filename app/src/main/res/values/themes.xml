         and system chrome follow the shell too. -->
    <style name="AppTheme.Mobile.Experimental" parent="Theme.Material3.Dark.NoActionBar">
        <item name="app_background_color">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
