<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Downloads are large and re-fetchable; user state syncs via the in-app backup. -->
        <exclude domain="file" path="downloads/" />
        <!-- Supabase session must never leave the device. -->
        <exclude domain="sharedpref" path="supabase_connection.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="downloads/" />
        <exclude domain="sharedpref" path="supabase_connection.xml" />
    </device-transfer>
</data-extraction-rules>
