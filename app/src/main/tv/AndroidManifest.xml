<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".activities.main.MainTvActivity"
            android:exported="true"
            android:theme="@style/AppTheme.Tv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="betterstreamflix" android:host="movie" />
                <data android:scheme="betterstreamflix" android:host="tvshow" />
                <data android:scheme="betterstreamflix" android:host="episode" />
                <data android:scheme="betterstreamflix" android:host="search" />
                <data android:scheme="betterstreamflix" android:host="provider" />
                <data android:scheme="betterstreamflix" android:host="favorites" />
                <data android:scheme="betterstreamflix" android:host="continue" />
            </intent-filter>
        </activity>
    </application>
</manifest>
